ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://localhost/budgetplate
RATE_LIMIT_PER_MINUTE=10
# Local dev only: run the weekly refresh in-process (prod uses GitHub Actions).
ENABLE_SCHEDULER=true

# Optional: override the meal-plan model without a code change (default
# claude-haiku-4-5 with a 4096-token cap). claude-haiku-5-5 needs
# CLAUDE_MAX_TOKENS=16000 because its thinking counts toward the cap.
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_MAX_TOKENS=4096
